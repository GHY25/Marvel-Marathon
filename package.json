{
	"name": "marvel-marathon",
	"version": "0.1.0",
	"description": "오프라인 MCU 영화 감상 기록과 나만의 평점",
	"keywords": [
		"electron",
		"mcu",
		"movie-diary",
		"offline"
	],
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "tsc -b && electron-vite build",
		"lint": "eslint .",
		"start": "electron-vite preview",
		"release": "npm run build && electron-builder --publish never",
		"format": "prettier --write .",
		"lang": "node -e \"if(process.platform==='win32'){require('child_process').spawnSync('chcp',['65001'],{stdio:'inherit',shell:true})}\"",
		"test": "vitest run",
		"test:e2e": "npm run build && playwright test",
		"package:dir": "npm run build && electron-builder --dir",
		"icons": "node scripts/generate-icon.mjs",
		"postinstall": "node -e \"if (process.env.ELECTRON_SKIP_BINARY_DOWNLOAD !== '1') require('electron/install')\""
	},
	"dependencies": {
		"lucide-react": "^1.69.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.18.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitejs/plugin-react": "^4.7.0",
		"electron": "45.2.3",
		"electron-builder": "^26.15.2",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"sharp": "^0.35.5",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vitest": "^5.1.0",
		"electron-vite": "^5.0.0",
		"prettier": "^3.8.4"
	},
	"build": {
		"files": [
			"dist/**/*",
			"package.json",
			"LICENSE"
		],
		"linux": {
			"icon": "public/app-icon.png",
			"category": "AudioVideo",
			"target": "AppImage"
		},
		"appId": "dev.personal.marvelmarathon",
		"nsis": {
			"deleteAppDataOnUninstall": false,
			"allowToChangeInstallationDirectory": true,
			"oneClick": false
		},
		"mac": {
			"icon": "public/app-icon.png",
			"category": "public.app-category.entertainment",
			"target": "dmg"
		},
		"asar": true,
		"productName": "Marvel Marathon",
		"win": {
			"artifactName": "Marvel-Marathon-${version}-Setup.${ext}",
			"icon": "public/app-icon.ico",
			"target": [
				"nsis"
			]
		},
		"directories": {
			"output": "release"
		}
	},
	"main": "dist/main/main.js",
	"private": true,
	"author": "Marvel Marathon contributors",
	"engines": {
		"node": "^22.13.0 || ^24.0.0 || >=26.0.0"
	},
	"overrides": {
		"minimatch@>=7 <11.0.1": "^11.0.4"
	}
}
